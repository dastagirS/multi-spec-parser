{
  "name": "multi-spec-parser",
  "version": "0.3.4",
  "description": "Parse OpenAPI 3.0/3.1, Swagger 2.0, and Google Discovery specs into one normalized model, with memory-safe per-tool schema compilation for building LLM tool sets.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./standard-schema": {
      "types": "./dist/src/standard-schema.d.ts",
      "import": "./dist/src/standard-schema.js"
    }
  },
  "files": [
    "dist/src",
    "examples",
    "native"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dastagirS/multi-spec-parser.git"
  },
  "bugs": {
    "url": "https://github.com/dastagirS/multi-spec-parser/issues"
  },
  "homepage": "https://github.com/dastagirS/multi-spec-parser#readme",
  "author": "dastagirS <shroud464@gmail.com>",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "install": "node native/install.mjs",
    "prepublishOnly": "npm run build && npm run native:prebuild",
    "native:build": "node native/build.mjs",
    "native:prebuild": "node native/build.mjs --prebuild-current",
    "test": "npm run build && node --test \"dist/test/unit/*.test.js\"",
    "battle": "npm run build && node dist/test/battle.js",
    "benchmark": "npm run build && node dist/test/benchmark.js",
    "fixtures": "npm run build && node dist/test/scripts/fetch-fixtures.js",
    "examples": "node examples/basic.mjs && node examples/multi-format.mjs && node examples/requests.mjs && node examples/llm-tools.mjs && node examples/policies.mjs && node examples/consumer-media-upload.mjs && node examples/google-attachment-to-s3.mjs",
    "check": "npm run build && node --test \"dist/test/unit/*.test.js\" && node dist/test/battle.js"
  },
  "keywords": [
    "openapi",
    "swagger",
    "google-discovery",
    "parser",
    "yaml",
    "llm",
    "tools"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "optionalDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
